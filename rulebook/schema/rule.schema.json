{
  "$id": "rule.schema.json",
  "title": "Rulebook record (SPEC_v2 6.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "scope", "title", "category", "rule_summary", "source_ref", "source_url", "source_title", "source_date",
               "citation", "last_reviewed", "severity", "violating_examples", "compliant_examples", "fix_patterns",
               "auto_fixable", "applies_to", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^(FDA|FTC|META|TT|GOOG|GEN)-[A-Z]+-\\d{2}$" },
    "scope": { "$ref": "common.json#/$defs/scope" },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "category": { "$ref": "common.json#/$defs/category" },
    "rule_summary": { "type": "string", "minLength": 40, "maxLength": 900 },
    "source_ref": { "type": "string" },
    "source_url": { "$ref": "common.json#/$defs/url" },
    "source_title": { "type": "string" },
    "source_date": { "$ref": "common.json#/$defs/date" },
    "citation": { "type": "string", "minLength": 2 },
    "required_text": { "type": "array", "items": { "type": "string" } },
    "last_reviewed": { "$ref": "common.json#/$defs/date" },
    "severity": { "$ref": "common.json#/$defs/severity" },
    "violating_examples": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "compliant_examples": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fix_patterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "auto_fixable": { "type": "boolean" },
    "applies_to": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.json#/$defs/channel" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
